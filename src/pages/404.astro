---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1>This page went offline.</h1>
    <p class="muted">Unlike a good sync engine, it isn't coming back on its own.</p>
    <p><a class="button primary" href="/">Go to the home page</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(4rem, 12vw, 8rem);
  }
</style>
