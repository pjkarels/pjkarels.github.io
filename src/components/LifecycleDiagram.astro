---
/** Outpost Sync mutation lifecycle: PENDING → IN_FLIGHT → one of four outcomes. */
const outcomes = [
  { state: "Delivered", detail: "Server accepted it, or the server's copy won. Row deleted; queued edits re-based.", tone: "ok" },
  { state: "PENDING (retry)", detail: "Network error, 5xx or 429: backoff with jitter. Also after a conflict is rebased, or a lease expires.", tone: "loop" },
  { state: "PARKED", detail: "A conflict the resolver can't settle. Blocks this record only until resolveParked() or discardParked().", tone: "warn" },
  { state: "FAILED", detail: "Rejected by the server or retries exhausted. Surfaced to the app; retryFailed() re-queues it.", tone: "bad" },
];
---

<figure class="diagram lifecycle" aria-label="Mutation lifecycle">
  <div class="track">
    <div class="state">
      <code>PENDING</code>
      <span>Saved locally by enqueue()</span>
    </div>
    <div class="arrow" aria-hidden="true">→</div>
    <div class="state">
      <code>IN_FLIGHT</code>
      <span>Claimed with a lease and a fencing token</span>
    </div>
    <div class="arrow" aria-hidden="true">→</div>
    <ul class="outcomes">
      {
        outcomes.map((o) => (
          <li class={o.tone}>
            <code>{o.state}</code>
            <span>{o.detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption>
    Every transition is applied only if the row is still on the attempt that produced it, so a worker that lost
    its lease can't overwrite a newer result.
  </figcaption>
</figure>

<style>
  .track {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1.6fr);
    align-items: center;
    gap: 0.6rem;
  }

  @media (max-width: 720px) {
    .track {
      grid-template-columns: 1fr;
    }
    .arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }

  .state,
  .outcomes li {
    display: grid;
    gap: 0.25rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
  }

  code {
    background: none;
    padding: 0;
    font-weight: 700;
    font-size: 0.85rem;
  }

  span {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .arrow {
    color: var(--muted);
    font-size: 1.2rem;
  }

  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .outcomes li {
    border-left-width: 4px;
    margin: 0;
  }

  .ok {
    border-left-color: var(--accent) !important;
  }
  .loop {
    border-left-color: #6b8cce !important;
  }
  .warn {
    border-left-color: #d49b2a !important;
  }
  .bad {
    border-left-color: #c8553d !important;
  }
</style>
