---
import { site, githubUrl } from "../site.config";

const links = [
  { label: "Email", value: site.email, href: site.email && `mailto:${site.email}`, primary: true },
  { label: "LinkedIn", value: "LinkedIn", href: site.linkedin },
  { label: "GitHub", value: `github.com/${site.github}`, href: site.github && githubUrl() },
  { label: "Résumé", value: "Download PDF", href: site.resume },
].filter((l) => l.href);
---

<ul class="contact">
  {
    links.map((l) => (
      <li>
        <a class:list={["button", { primary: l.primary }]} href={l.href}>
          <span class="sr-only">{l.label}: </span>
          {l.value}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
