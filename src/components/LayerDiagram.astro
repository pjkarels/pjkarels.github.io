---
/**
 * A responsive layered architecture diagram in HTML (text stays readable on phones,
 * unlike a scaled-down SVG). Each layer is a row of boxes; rows stack top to bottom.
 */
interface Box {
  title: string;
  detail?: string;
  /** Highlight a box, e.g. the part this page is about. */
  accent?: boolean;
  /** De-emphasize a box that sits outside the system. */
  external?: boolean;
}
interface Layer {
  label: string;
  boxes: Box[];
}
interface Props {
  layers: Layer[];
  caption: string;
  title: string;
}
const { layers, caption, title } = Astro.props;
---

<figure class="diagram layer-diagram" aria-label={title}>
  <ol class="layers">
    {
      layers.map((layer) => (
        <li class="layer">
          <span class="layer-label">{layer.label}</span>
          <ul class="boxes" style={`--cols: ${layer.boxes.length}`}>
            {layer.boxes.map((box) => (
              <li class:list={["box", { accent: box.accent, external: box.external }]}>
                <strong>{box.title}</strong>
                {box.detail && <span>{box.detail}</span>}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }

  .layer {
    position: relative;
    display: grid;
    gap: 0.4rem;
  }

  /* connector between layers */
  .layer + .layer::before {
    content: "";
    position: absolute;
    top: -1.45rem;
    left: 50%;
    width: 2px;
    height: 1.3rem;
    background: var(--border);
    transform: translateX(-50%);
  }

  .layer-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .boxes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 0.6rem;
  }

  @media (max-width: 560px) {
    .boxes {
      grid-template-columns: 1fr;
    }
  }

  .box {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
    margin: 0;
  }

  .box strong {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .box span {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .box.accent {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .box.external {
    background: transparent;
    border-style: dashed;
  }
</style>
