---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const { title, summary, kind, role, period, stack, highlights } = entry.data;
---

<article class="card">
  <p class="eyebrow">{kind} · {period}</p>
  <h3><a href={`/work/${entry.id}/`}>{title}</a></h3>
  <p class="role muted">{role}</p>
  <p>{summary}</p>
  {
    highlights.length > 0 && (
      <dl class="stats">
        {highlights.slice(0, 3).map((h) => (
          <div>
            <dt>{h.label}</dt>
            <dd>{h.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <ul class="tags">{stack.slice(0, 6).map((s) => <li>{s}</li>)}</ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: border-color 0.15s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
  }

  h3 {
    margin: 0;
    font-size: 1.3rem;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  /* whole card is clickable via the title link */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .role {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0.5rem 0 1.25rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  dt {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.3;
  }

  dd {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .tags {
    margin-top: auto;
  }
</style>
